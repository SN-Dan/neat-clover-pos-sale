<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_pay_by_clover_terminal_sale_order" model="ir.actions.server">
        <field name="name">Pay by Clover Terminal</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">if records:
    action = records.action_open_clover_terminal_payment_wizard()
        </field>
    </record>

    <!-- Unbind obsolete separate Pre-Authorize action (merged into Pay wizard). -->
    <record id="action_preauth_by_clover_terminal_sale_order" model="ir.actions.server">
        <field name="name">Pre-Authorize by Clover Terminal</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" eval="False"/>
        <field name="state">code</field>
        <field name="code">action = {'type': 'ir.actions.act_window_close'}
        </field>
    </record>

    <record id="action_charge_by_clover_terminal_sale_order" model="ir.actions.server">
        <field name="name">Charge / Void Pre-Authorization</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">if records:
    action = records.action_open_clover_terminal_charge_wizard()
        </field>
    </record>

    <record id="action_refund_by_clover_terminal_sale_order" model="ir.actions.server">
        <field name="name">Refund by Clover Terminal</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">if records:
    action = records.action_open_clover_terminal_refund_wizard()
        </field>
    </record>

</odoo>
